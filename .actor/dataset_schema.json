{
    "$schema": "https://apify.com/schemas/v1/dataset.ide.json",
    "actorSpecification": 1,
    "fields": {
        "type": "object",
        "properties": {
            "rank": {
                "type": "integer",
                "description": "Rank of this highlight clip (1 = highest score)",
                "example": 1
            },
            "Title": {
                "type": "string",
                "description": "Engaging viral title for this highlight clip",
                "example": "Epic Game Winning Play"
            },
            "score": {
                "type": "number",
                "description": "Composite engagement score from 0 to 100",
                "example": 87.4
            },
            "start_time": {
                "type": "string",
                "description": "Clip start time formatted as HH:MM:SS",
                "example": "01:23:45"
            },
            "end_time": {
                "type": "string",
                "description": "Clip end time formatted as HH:MM:SS",
                "example": "01:24:30"
            },
            "duration_seconds": {
                "type": "number",
                "description": "Duration of the clip in seconds",
                "example": 45.0
            },
            "detection_reasons": {
                "type": "array",
                "items": {
                    "type": "string"
                },
                "description": "Array of trigger explanations for this highlight",
                "example": [
                    "audio_volume_spike_+18dB",
                    "chat_velocity_320%",
                    "keyword_trigger_!clip"
                ]
            },
            "transcript": {
                "type": "string",
                "description": "Spoken text during this highlight segment",
                "example": "Oh my god, did you see that?! That was absolutely incredible!"
            },
            "direct_timestamp_url": {
                "type": ["string", "null"],
                "description": "Direct YouTube link jumping to the clip start time",
                "example": "https://youtu.be/dQw4w9WgXcQ?t=5025"
            },
            "ffmpeg_command": {
                "type": "string",
                "description": "Copy-pasteable command to extract this clip losslessly using yt-dlp and ffmpeg",
                "example": "ffmpeg -ss 01:23:45 -to 01:24:30 -i \"$(yt-dlp -g -f 'bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best' 'https://www.youtube.com/watch?v=dQw4w9WgXcQ')\" -c copy clip_1.mp4"
            },
            "download_link": {
                "type": ["string", "null"],
                "description": "Direct YouTube timestamp link when 'youtube_url' is used; null when 'file_video' is used",
                "example": "https://youtu.be/dQw4w9WgXcQ?t=5025"
            },
            "Download Link": {
                "type": ["string", "null"],
                "description": "Direct YouTube timestamp link when 'youtube_url' is used; null when 'file_video' is used",
                "example": "https://youtu.be/dQw4w9WgXcQ?t=5025"
            },
            "download_url": {
                "type": ["string", "null"],
                "description": "Direct download link for the cut video clip from the Key-Value Store when 'file_video' is used; null when 'youtube_url' is used",
                "example": "https://api.apify.com/v2/key-value-stores/.../records/clip_1.mp4"
            },
            "clip_filename": {
                "type": ["string", "null"],
                "description": "Filename of the trimmed clip",
                "example": "clip_1.mp4"
            },
            "clip_size_mb": {
                "type": ["number", "null"],
                "description": "File size of the trimmed clip in megabytes",
                "example": 4.21
            },
            "title": {
                "type": ["string", "null"],
                "description": "Title of the highlight clip",
                "example": "Epic Game Winning Play"
            },
            "target_format": {
                "type": "string",
                "description": "Target social media video format and resolution profile",
                "example": "INSTAGRAM_REELS_VERTICAL_9_16_HIGHRES_1080P_MP4"
            },
            "viral_hook": {
                "type": "string",
                "description": "First 3-second attention-grabbing on-screen hook (without emojis or icons)",
                "example": "Wait for what happens next..."
            },
            "Caption": {
                "type": "string",
                "description": "Engaging social media post description with call to action (without emojis or icons)",
                "example": "You will not believe how this turned out. Drop your thoughts below."
            },
            "Hashtag": {
                "type": "array",
                "items": {
                    "type": "string"
                },
                "description": "Trending and topic-specific hashtags for social posting",
                "example": [
                    "#shorts",
                    "#reels",
                    "#viral",
                    "#podcast",
                    "#trending"
                ]
            },
            "Virality_score_description": {
                "type": "string",
                "description": "Detailed explanation of viral potential, retention triggers, and audience engagement",
                "example": "Score 92/100: High emotional spike with strong curiosity gap and immediate comment trigger."
            },
            "subtitles_url": {
                "type": ["string", "null"],
                "description": "Direct download link for the animated ASS karaoke subtitle file",
                "example": "https://api.apify.com/v2/key-value-stores/.../records/clip_1.ass"
            }
        }
    },
    "views": {
        "overview": {
            "title": "Highlight Clips",
            "transformation": {
                "fields": [
                    "rank",
                    "Title",
                    "score",
                    "viral_hook",
                    "Caption",
                    "Hashtag",
                    "Virality_score_description",
                    "start_time",
                    "end_time",
                    "duration_seconds",
                    "target_format",
                    "detection_reasons",
                    "transcript",
                    "direct_timestamp_url",
                    "download_link",
                    "download_url",
                    "ffmpeg_command"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "rank": {
                        "label": "#",
                        "format": "number"
                    },
                    "Title": {
                        "label": "Title",
                        "format": "text"
                    },
                    "score": {
                        "label": "Score",
                        "format": "number"
                    },
                    "viral_hook": {
                        "label": "Viral Hook",
                        "format": "text"
                    },
                    "Caption": {
                        "label": "Caption",
                        "format": "text"
                    },
                    "Hashtag": {
                        "label": "Hashtags",
                        "format": "array"
                    },
                    "Virality_score_description": {
                        "label": "Virality Rationale",
                        "format": "text"
                    },
                    "start_time": {
                        "label": "Start",
                        "format": "text"
                    },
                    "end_time": {
                        "label": "End",
                        "format": "text"
                    },
                    "duration_seconds": {
                        "label": "Duration (s)",
                        "format": "number"
                    },
                    "target_format": {
                        "label": "Format",
                        "format": "text"
                    },
                    "detection_reasons": {
                        "label": "Triggers",
                        "format": "array"
                    },
                    "transcript": {
                        "label": "Transcript",
                        "format": "text"
                    },
                    "download_link": {
                        "label": "Download Link",
                        "format": "link"
                    },
                    "download_url": {
                        "label": "Download Video",
                        "format": "link"
                    },
                    "direct_timestamp_url": {
                        "label": "Link",
                        "format": "link"
                    },
                    "ffmpeg_command": {
                        "label": "FFmpeg Command",
                        "format": "text"
                    }
                }
            }
        }
    }
}