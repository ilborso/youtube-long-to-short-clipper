# ==============================================================================
# YouTube Highlight Clipper - Environment Variables
# ==============================================================================

# Apify RESIDENTIAL Proxy Password
# Used to route all YouTube requests (metadata, worst audio stream, subtitles, chat)
# through: http://groups-RESIDENTIAL:<APIFY_PROXY_PASSWORD>@proxy.apify.com:8000
APIFY_PROXY_PASSWORD=your_apify_proxy_password_here

# Google Gemini API Key (Optional)
# Used for AI boundary refinement and transcript polishing (model: gemini-2.0-flash)
GEMINI_API_KEY=your_gemini_api_key_here
