# ==============================================================================
# YouTube Highlight Clipper - Environment Variables
# ==============================================================================

# Apify RESIDENTIAL Proxy Password
# Used to route all YouTube requests (metadata, worst audio stream, subtitles, chat)
# through: http://groups-RESIDENTIAL:<APIFY_PROXY_PASSWORD>@proxy.apify.com:8000
APIFY_PROXY_PASSWORD=your_apify_proxy_password_here

# Google Gemini API Key
# Used for AI salient highlights detection from video transcript
GEMINI_API_KEY=your_gemini_api_key_here

# Google Gemini Model Name
# Specify which Gemini model to use (default: gemini-flash-lite-latest, e.g. gemini-flash-lite-latest, gemini-2.0-flash, etc.)
MODEL=gemini-flash-lite-latest

# YouTube Cookies (Optional)
# Raw Netscape cookies or Base64 string exported from browser (e.g. via Get cookies.txt LOCALLY)
# Needed only if YouTube requires sign-in for age-restricted or strictly gated videos
YOUTUBE_COOKIES=
